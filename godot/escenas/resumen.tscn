[gd_scene format=3]

[ext_resource type="Script" path="res://escenas/resumen.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="Fondo"]
bg_color = Color(0.055, 0.102, 0.133, 1)
content_margin_left = 24.0
content_margin_right = 24.0
content_margin_top = 20.0
content_margin_bottom = 20.0

[node name="Resumen" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Fondo")
script = ExtResource("1")

[node name="Contenido" type="VBoxContainer" parent="."]
theme_override_constants/separation = 12

[node name="Cabecera" type="HFlowContainer" parent="Contenido"]
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 8

[node name="Titulo" type="Label" parent="Contenido/Cabecera"]
theme_type_variation = &"Titulo"
text = "Resumen de la práctica"

[node name="Estado" type="Label" parent="Contenido/Cabecera"]
unique_name_in_owner = true
size_flags_vertical = 4
vertical_alignment = 1
theme_type_variation = &"Chip"

[node name="Orden" type="HFlowContainer" parent="Contenido"]
unique_name_in_owner = true
theme_override_constants/h_separation = 12

[node name="NombreOrden" type="Label" parent="Contenido/Orden"]
unique_name_in_owner = true
theme_type_variation = &"Metadato"
size_flags_horizontal = 3
autowrap_mode = 3

[node name="Marca" type="Label" parent="Contenido/Orden"]
unique_name_in_owner = true
visible = false
theme_type_variation = &"ChipOrden"

[node name="Vacio" type="Label" parent="Contenido"]
unique_name_in_owner = true
autowrap_mode = 3
text = "Termina una práctica para revisar tus decisiones y comparar intentos."

[node name="Desplazamiento" type="ScrollContainer" parent="Contenido"]
unique_name_in_owner = true
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Lectura" type="VBoxContainer" parent="Contenido/Desplazamiento"]
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Aviso" type="Label" parent="Contenido/Desplazamiento/Lectura"]
unique_name_in_owner = true
visible = false
theme_override_colors/font_color = Color(1, 0.78, 0.4, 1)
autowrap_mode = 3

[node name="Indicadores" type="GridContainer" parent="Contenido/Desplazamiento/Lectura"]
unique_name_in_owner = true
columns = 4
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16

[node name="Columnas" type="GridContainer" parent="Contenido/Desplazamiento/Lectura"]
unique_name_in_owner = true
columns = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16

[node name="Pasos" type="PanelContainer" parent="Contenido/Desplazamiento/Lectura/Columnas"]
size_flags_horizontal = 3
size_flags_vertical = 0

[node name="PasosContenido" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Pasos"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Titulo" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Pasos/PasosContenido"]
theme_type_variation = &"Seccion"
text = "Paso a paso"

[node name="Detalle" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Pasos/PasosContenido"]
unique_name_in_owner = true
theme_override_constants/separation = 0

[node name="Cierre" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Columnas"]
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Diagnostico" type="PanelContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre"]
size_flags_horizontal = 3
size_flags_vertical = 0

[node name="DiagnosticoContenido" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/Diagnostico"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Titulo" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/Diagnostico/DiagnosticoContenido"]
theme_type_variation = &"Seccion"
text = "Diagnóstico"

[node name="ReflexionTarjeta" type="PanelContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre"]
size_flags_horizontal = 3
size_flags_vertical = 0

[node name="ReflexionTarjetaContenido" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/ReflexionTarjeta"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Pregunta" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/ReflexionTarjeta/ReflexionTarjetaContenido"]
unique_name_in_owner = true
theme_type_variation = &"Seccion"
autowrap_mode = 3

[node name="Respuesta" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/ReflexionTarjeta/ReflexionTarjetaContenido"]
unique_name_in_owner = true
visible = false
autowrap_mode = 3

[node name="Reflexion" type="LineEdit" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/ReflexionTarjeta/ReflexionTarjetaContenido"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)

[node name="Validacion" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/ReflexionTarjeta/ReflexionTarjetaContenido"]
unique_name_in_owner = true
visible = false
theme_type_variation = &"Aviso"
autowrap_mode = 3
text = "Escribe tu respuesta o pulsa Omitir"

[node name="RutaTarjeta" type="PanelContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre"]
size_flags_horizontal = 3
size_flags_vertical = 0

[node name="RutaTarjetaContenido" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/RutaTarjeta"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Titulo" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/RutaTarjeta/RutaTarjetaContenido"]
theme_type_variation = &"Seccion"
text = "Ruta ideal"

[node name="Ruta" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/RutaTarjeta/RutaTarjetaContenido"]
unique_name_in_owner = true
autowrap_mode = 3

[node name="FuenteRuta" type="Label" parent="Contenido/Desplazamiento/Lectura/Columnas/Cierre/RutaTarjeta/RutaTarjetaContenido"]
unique_name_in_owner = true
theme_type_variation = &"Secundario"
autowrap_mode = 3

[node name="Comparacion" type="PanelContainer" parent="Contenido/Desplazamiento/Lectura"]
size_flags_horizontal = 3
size_flags_vertical = 0

[node name="ComparacionContenido" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Comparacion"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Titulo" type="Label" parent="Contenido/Desplazamiento/Lectura/Comparacion/ComparacionContenido"]
theme_type_variation = &"Seccion"
text = "Comparación"

[node name="Brechas" type="PanelContainer" parent="Contenido/Desplazamiento/Lectura"]
size_flags_horizontal = 3
size_flags_vertical = 0

[node name="BrechasContenido" type="VBoxContainer" parent="Contenido/Desplazamiento/Lectura/Brechas"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Titulo" type="Label" parent="Contenido/Desplazamiento/Lectura/Brechas/BrechasContenido"]
theme_type_variation = &"Seccion"
text = "Lo que dijiste vs lo que hiciste"

[node name="Acciones" type="HFlowContainer" parent="Contenido"]
unique_name_in_owner = true
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6

[node name="Guardar" type="Button" parent="Contenido/Acciones"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
text = "Guardar y ver ruta ideal"
theme_type_variation = &"Primario"

[node name="Omitir" type="Button" parent="Contenido/Acciones"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
text = "Omitir"

[node name="Reintentar" type="Button" parent="Contenido/Acciones"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
text = "Reintentar"

[node name="Volver" type="Button" parent="Contenido/Acciones"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
text = "Volver al menú"
