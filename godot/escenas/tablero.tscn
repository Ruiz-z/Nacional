[gd_scene format=3]

[ext_resource type="Script" path="res://escenas/tablero.gd" id="1"]

[node name="Tablero" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
script = ExtResource("1")

[node name="Titulo" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Titulo"
text = "Tablero de progreso"

[node name="Subtitulo" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Secundario"
text = "Revisa tu progreso y tus errores por tema."

[node name="Vistas" type="HBoxContainer" parent="."]

[node name="Tecnico" type="Button" parent="Vistas"]
custom_minimum_size = Vector2(0, 52)
text = "Vista del técnico"

[node name="JefeDirecto" type="Button" parent="Vistas"]
custom_minimum_size = Vector2(0, 52)
text = "Jefe directo"

[node name="Ayuda" type="Button" parent="Vistas"]
custom_minimum_size = Vector2(0, 52)
text = "Cómo se calcula tu progreso"
toggle_mode = true

[node name="Espacio" type="Control" parent="Vistas"]
size_flags_horizontal = 3

[node name="VolverLista" type="Button" parent="Vistas"]
visible = false
custom_minimum_size = Vector2(0, 52)
text = "Volver a la lista"

[node name="Exportar" type="Button" parent="Vistas"]
visible = false
custom_minimum_size = Vector2(0, 52)
text = "Exportar"

[node name="Contenido" type="ScrollContainer" parent="."]
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Datos" type="VBoxContainer" parent="Contenido"]
size_flags_horizontal = 3
theme_override_constants/separation = 10


[node name="GuardarResultados" type="FileDialog" parent="."]
title = "Exportar resultados"
size = Vector2i(740, 480)
file_mode = 4
access = 2
filters = PackedStringArray("*.csv ; Resultados CSV", "*.json ; Resultados JSON")

[node name="AvisoExportacion" type="AcceptDialog" parent="."]
title = "Exportar resultados"
