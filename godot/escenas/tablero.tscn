[gd_scene format=3]

[ext_resource type="Script" path="res://escenas/tablero.gd" id="1"]

[node name="Tablero" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
script = ExtResource("1")

[node name="Titulo" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Titulo"
text = "Tablero de progreso"

[node name="Subtitulo" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Secundario"
text = "Dominio, errores y evolución por competencia."

[node name="Vistas" type="HBoxContainer" parent="."]

[node name="Tecnico" type="Button" parent="Vistas"]
custom_minimum_size = Vector2(0, 52)
text = "Vista del técnico"

[node name="Instructor" type="Button" parent="Vistas"]
custom_minimum_size = Vector2(0, 52)
text = "Vista del instructor"

[node name="Ayuda" type="Button" parent="Vistas"]
custom_minimum_size = Vector2(0, 52)
text = "Fórmulas de los indicadores"
toggle_mode = true

[node name="Alias" type="OptionButton" parent="."]
custom_minimum_size = Vector2(0, 52)

[node name="Contenido" type="ScrollContainer" parent="."]
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Datos" type="VBoxContainer" parent="Contenido"]
size_flags_horizontal = 3
theme_override_constants/separation = 10
