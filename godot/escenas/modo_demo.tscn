[gd_scene format=3]

[ext_resource type="Script" path="res://escenas/modo_demo.gd" id="1"]

[node name="ModoDemo" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
script = ExtResource("1")

[node name="Titulo" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Titulo"
text = "Modo demo"

[node name="Descripcion" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Secundario"
text = "Abre una práctica o mira un historial de ejemplo."

[node name="Estado" type="Label" parent="."]
size_flags_horizontal = 0
theme_type_variation = &"Chip"

[node name="Escenario" type="Button" parent="."]
custom_minimum_size = Vector2(0, 52)
text = "Practicar en la demo"
theme_type_variation = &"Primario"

[node name="Tablero" type="Button" parent="."]
custom_minimum_size = Vector2(0, 52)
text = "Abrir tablero de la demo"

[node name="Reloj" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Seccion"
text = "Reloj de la demostración"

[node name="Explicacion" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Secundario"
text = "Adelanta el reloj para repetir la evaluación y ver qué recuerdas."

[node name="Adelantar" type="Button" parent="."]
custom_minimum_size = Vector2(0, 52)
text = "Adelantar reloj 7 días"

[node name="Restablecer" type="Button" parent="."]
custom_minimum_size = Vector2(0, 52)
text = "Restablecer demo"

[node name="Aviso" type="Label" parent="."]
autowrap_mode = 3
theme_type_variation = &"Aviso"
