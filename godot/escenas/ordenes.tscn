[gd_scene format=3]

[ext_resource type="Script" path="res://escenas/ordenes.gd" id="1"]

[node name="Ordenes" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true
script = ExtResource("1")

[node name="Centro" type="CenterContainer" parent="."]
size_flags_horizontal = 3

[node name="Columna" type="VBoxContainer" parent="Centro"]
size_flags_vertical = 0
theme_override_constants/separation = 16

[node name="Titulo" type="Label" parent="Centro/Columna"]
theme_type_variation = &"TituloClaro"
theme_override_font_sizes/font_size = 32
text = "Órdenes de servicio"

[node name="Filtros" type="HBoxContainer" parent="Centro/Columna"]

[node name="Tarjetas" type="VBoxContainer" parent="Centro/Columna"]
theme_override_constants/separation = 16

[node name="Aviso" type="Label" parent="Centro/Columna"]
visible = false
theme_type_variation = &"DetalleClaro"
autowrap_mode = 3
